<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E60D1220" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FFC940" />
        </shape>
    </item>
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#66FFC940" />
        </shape>
    </item>
    <item android:gravity="top|left" android:width="12dp" android:height="12dp" android:drawable="@drawable/kanote_diamond" />
    <item android:gravity="top|right" android:width="12dp" android:height="12dp" android:drawable="@drawable/kanote_diamond" />
    <item android:gravity="bottom|left" android:width="12dp" android:height="12dp" android:drawable="@drawable/kanote_diamond" />
    <item android:gravity="bottom|right" android:width="12dp" android:height="12dp" android:drawable="@drawable/kanote_diamond" />
</layer-list>
